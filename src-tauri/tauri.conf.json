{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Castaway",
  "version": "0.1.5",
  "identifier": "com.castaway.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Castaway",
        "width": 520,
        "height": 680,
        "resizable": true,
        "minWidth": 460,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/uxplay/**/*",
      "resources/SOURCE.txt",
      "resources/LICENSE-Castaway.txt",
      "resources/THIRD-PARTY-NOTICES.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1QTg1NzUyQkY0NEExMzkKUldRNW9VUy9VbGVvSmNjWmJETFg5Ri9UbHNieksxSUgrdEhwbVJwaThtdUFtKzlaOW04WGlKaWcK",
      "endpoints": [
        "https://github.com/ketiaaa/castaway/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
